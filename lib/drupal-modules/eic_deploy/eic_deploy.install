<?php

/**
 * @file
 * Install and update hooks for the EIC Deploy module.
 */

/**
 * Enable the CiviCRM SES extension.
 */
function eic_deploy_update_10003(): void {
  \Drupal::service('civicrm')->initialize();

  $result = civicrm_api3('Extension', 'enable', ['keys' => 'ses']);

  if (!empty($result['is_error'])) {
    throw new \Drupal\Core\Utility\UpdateException(
      'Failed to enable CiviCRM SES extension: ' . ($result['error_message'] ?? 'Unknown error')
    );
  }
}

/**
 * Enable the CiviCRM Export Permission and Contact Layout Editor extensions.
 */
function eic_deploy_update_10004(): void {
  \Drupal::service('civicrm')->initialize();

  $result = civicrm_api3('Extension', 'enable', [
    'keys' => ['net.ourpowerbase.exportpermission', 'org.civicrm.contactlayout'],
  ]);

  if (!empty($result['is_error'])) {
    throw new \Drupal\Core\Utility\UpdateException(
      'Failed to enable CiviCRM extensions: ' . ($result['error_message'] ?? 'Unknown error')
    );
  }
}

/**
 * Enable the CiviRules extension (dependency of eic_config).
 */
function eic_deploy_update_10005(): void {
  \Drupal::service('civicrm')->initialize();

  $result = civicrm_api3('Extension', 'enable', ['keys' => 'org.civicoop.civirules']);

  if (!empty($result['is_error'])) {
    throw new \Drupal\Core\Utility\UpdateException(
      'Failed to enable CiviRules extension: ' . ($result['error_message'] ?? 'Unknown error')
    );
  }
}

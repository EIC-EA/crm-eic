            "configuration": {
                "regex_find": "\/^(?:[a-zA-Z][a-zA-Z\\d+\\-.]*:\\\/\\\/)?(?:[^\\\/?#@]+@)?(?:www\\.)?([^\\\/?#:]+).*$\/",

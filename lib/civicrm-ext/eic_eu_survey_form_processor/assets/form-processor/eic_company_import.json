        {
            "weight": "1",
            "include_formatted_params": "0",
            "title": "Organisation name",
            "name": "org_name",
            "type": "String",
            "is_required": "0",
            "default_value": "",
            "configuration": {
                "trim": "1"
            },
            "parameter_mapping": [],
            "default_data_parameter_mapping": [],
            "validators": []
        },

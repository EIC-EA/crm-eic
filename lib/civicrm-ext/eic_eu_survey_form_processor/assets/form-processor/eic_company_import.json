{
    "title": "EIC Company Import",
    "name": "eic_company_import",
    "is_active": "1",
    "description": "This FormProcessor creates or matches beneficiary organisation contacts (sub-type EIC_Organisation) from the dataset, setting the organisation name, website, and PIC Number.\r\n\r\nThe `PIC Number` is stored in the custom field `EIC_Organisation_identifiers.PIC` (not the External Identifier) and uniquely identifies a company later on, when attaching cases to the company.\r\n\r\nThis import runs before the survey is answered, so it does NOT set the survey company data (CEO/founder gender, sector, TRL/CRL/BRL/FRL) - that data is written by the Accelerator survey import where it first arrives.\r\n",
    "output_handler": "OutputAllActionOutput",
    "output_handler_configuration": [],
    "enable_default_data": "0",
    "default_data_output_configuration": [],
    "calculation_output_configuration": [],
    "permission": "",
    "inputs": [
        {
            "weight": "1",
            "include_formatted_params": "0",
            "title": "Organisation name",
            "name": "org_name",
            "type": "String",
            "is_required": "0",
            "default_value": "",
            "configuration": {
                "trim": "1"
            },
            "parameter_mapping": [],
            "default_data_parameter_mapping": [],
            "validators": []
        },
        {
            "weight": "2",

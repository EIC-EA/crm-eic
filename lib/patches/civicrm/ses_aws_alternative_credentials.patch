+      if (!empty($ses_access_key) && !empty($ses_secret_key) && !empty($ses_region)) {
+        // Use explicit credentials from CiviCRM settings
+        $credentials = new Credentials($ses_access_key, $ses_secret_key);
+        self::$instance = new SesClient([
+          'version' => 'latest',
+          'region' => $ses_region,
+          'credentials' => $credentials,
+        ]);
+      } else {
+        // Fall back to ECS container role / instance profile credentials
+        // The SDK will automatically resolve credentials from the
+        // ECS task role (AWS_CONTAINER_CREDENTIALS_RELATIVE_URI) or
+        // EC2 instance metadata.
+        // Region falls back to AWS_DEFAULT_REGION or AWS_REGION env vars.
+        $region = !empty($ses_region) ? $ses_region : (getenv('SES_REGION') ?: getenv('AWS_DEFAULT_REGION'));
+        if (empty($region)) {
+          throw new Exception("Missing required Amazon SES region. Please configure the extention in Administer > CiviMail > SES settings or set the AWS_DEFAULT_REGION environment variable.");
+        }
+        self::$instance = new SesClient([
+          'version' => 'latest',
+          'region' => $region,
+        ]);
+      }
     }
     return self::$instance;

       $ses_access_key = Civi::settings()->get('ses_access_key');
       $ses_secret_key = Civi::settings()->get('ses_secret_key');
       $ses_region = Civi::settings()->get('ses_region');
-      if (empty($ses_access_key) || empty($ses_secret_key) || empty($ses_region)) {
